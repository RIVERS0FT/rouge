{
  "name": "rouge",
  "version": "0.9.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "lan": "node --experimental-strip-types server/lan.ts",
    "test:e2e": "playwright test",
    "profile:acceptance": "node --experimental-strip-types scripts/profile-performance-acceptance.mjs",
    "prepare:map": "node --max-old-space-size=2048 scripts/build-world.mjs && node --experimental-strip-types scripts/write-gameplay-map.mjs",
    "predev": "npm run prepare:map",
    "prebuild": "npm run prepare:map",
    "pretest": "npm run prepare:map",
    "prelan": "npm run prepare:map"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.8.3",
    "vite": "7.1.12"
  }
}
